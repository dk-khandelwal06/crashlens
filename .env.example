# CrashLens Environment Configuration Example
# No private secrets are required for public read-only static hotspot intelligence.
# Custom tile server URL or base endpoints can be configured here if needed:
NEXT_PUBLIC_APP_NAME="CrashLens"
NEXT_PUBLIC_DEFAULT_REGION="Greater London"
NEXT_PUBLIC_DEFAULT_YEAR="2022"
NEXT_PUBLIC_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
NEXT_PUBLIC_TILE_ATTRIBUTION="&copy; <a href='https://www.openstreetmap.org/copyright'>OpenStreetMap</a> contributors &copy; <a href='https://carto.com/attributions'>CARTO</a>"
